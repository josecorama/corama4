# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
AUTH_DOMAIN=your-project.firebaseapp.com
DATABASE_URL=sqlite:///./corama_dev.db
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
PROJECT_ID=your-project-id
STORAGE_BUCKET=your-project.appspot.com
MESSAGING_SENDER_ID=123456789
APP_ID=1:123456789:web:abcdef123456
MEASUREMENT_ID=G-ABCDEF123
SERVICE_ACCOUNT_JSON=path/to/service-account.json
FLASK_SECRET_KEY=your_secret_key_here

# Environment
ENV=development
NODE_ENV=development
IS_DEV_ADMIN=true

# Stripe Test Mode Keys
STRIPE_API_KEY=sk_test_your_stripe_test_secret_key
STRIPE_API_WEBHOOK_KEY=whsec_your_stripe_webhook_secret

# Qdrant Configuration
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# OpenAI API Keys
SMART_SEARCH_OPENAI_API_KEY=sk-proj-your_openai_api_key
BID_RESPONSE_OPENAI_API_KEY=sk-proj-your_openai_api_key
CS_BUILDER_OPENAI_API_KEY=sk-proj-your_openai_api_key
CS_BID_SEARCH_OPENAI_API_KEY=sk-proj-your_openai_api_key

# Email Configuration
EMAIL_GOOGLE_USER=your_email@gmail.com
EMAIL_GOOGLE_PASS=your_app_password
